# Copy to .env for local development; process environment takes precedence.
# Do not put real credentials in this example.

# MongoDB: use a hosted/reachable URI when deploying to JacHammer.
MONGODB_URI=
MONGODB_DB=fixora_dev
# On JacHammer, prefer FIXORA_MONGODB_URI instead of exporting MONGODB_URI:
# the latter also configures Jac's separate graph-runtime persistence.
# FIXORA_MONGODB_URI=

# Application settings (not built-in Jac settings).
# Use a supported provider/model ID from your provider's current model list.
# Local Ollama example: FIXORA_MODEL=ollama_chat/gemma3:4b
# Choose an installed vision-capable Ollama model; hardware/latency must be tested.
FIXORA_MODEL=
FIXORA_DEMO_MODE=false
FIXORA_SHOP_TIMEZONE=Asia/Colombo

# Required for every case, evidence, and platform-status operation (16+ characters).
# Used only by the server-side owner gateway and worker; never supplied by the browser.
FIXORA_ACCESS_TOKEN=

# Gemini: obtain a key from Google AI Studio. Keep it server-side.
GOOGLE_API_KEY=
# Other supported provider names: OPENAI_API_KEY, ANTHROPIC_API_KEY, OPENROUTER_API_KEY.
# FIXORA_MODEL_API_KEY can override the provider-specific key for this app.
# Ollama requires no key locally. On JacHammer localhost is the hosted server.
# FIXORA_MODEL_BASE_URL=http://localhost:11434

# WhatsApp customer channel: Meta Developer app > WhatsApp > API Setup.
# Copy a supported Graph API version from that dashboard, such as vNN.N.
WHATSAPP_GRAPH_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
# Choose a separate random webhook verification token.
WHATSAPP_VERIFY_TOKEN=

# Private owner gateway. Choose a password with at least 16 characters.
FIXORA_OWNER_PASSWORD=
FIXORA_JAC_URL=http://127.0.0.1:8000
FIXORA_OWNER_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Optional separate text intake model; defaults to FIXORA_MODEL and the same key.
# FIXORA_INTAKE_MODEL=

# English voice notes: OpenAI transcription, separate from the intake/vision provider.
# Falls back to OPENAI_API_KEY when the explicit transcription key is blank.
FIXORA_TRANSCRIPTION_API_KEY=
FIXORA_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Optional approved, no-parameter utility template, used only after customer UPDATES opt-in.
# Without a template, expired-window updates wait for the customer to message again.
WHATSAPP_UPDATE_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
