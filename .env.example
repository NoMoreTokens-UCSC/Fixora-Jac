# Copy to .env for local development; application loading is not implemented.
# Do not put real credentials in this example.

# MongoDB: use a hosted/reachable URI when deploying to JacHammer.
MONGODB_URI=
MONGODB_DB=fixora_dev

# Application settings to implement; these are not built-in Jac settings.
FIXORA_MODEL=
FIXORA_DEMO_MODE=false
FIXORA_SHOP_TIMEZONE=Asia/Colombo

# Add the selected provider's actual API-key variable here once agreed.
# Member A: add the chosen server-side demo-access setting if required for hosting.
