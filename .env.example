# Copy to .env for local development; process environment takes precedence.
# Do not put real credentials in this example.

# MongoDB: use a hosted/reachable URI when deploying to JacHammer.
MONGODB_URI=
MONGODB_DB=fixora_dev
# On JacHammer, prefer FIXORA_MONGODB_URI instead of exporting MONGODB_URI:
# the latter also configures Jac's separate graph-runtime persistence.
# FIXORA_MONGODB_URI=

# Application settings (not built-in Jac settings).
# Hosted Gemini example: FIXORA_MODEL=gemini/gemini-3.8-flash
# Local Ollama example: FIXORA_MODEL=ollama_chat/gemma3:4b
# Choose an installed vision-capable Ollama model; hardware/latency must be tested.
FIXORA_MODEL=
FIXORA_DEMO_MODE=false
FIXORA_SHOP_TIMEZONE=Asia/Colombo

# Required for every case, evidence, and platform-status operation (16+ characters).
# Supply this at runtime from the UI; never embed it in a public client bundle.
FIXORA_ACCESS_TOKEN=

# Gemini: obtain a key from Google AI Studio. Keep it server-side.
GOOGLE_API_KEY=
# Other supported provider names: OPENAI_API_KEY, ANTHROPIC_API_KEY, OPENROUTER_API_KEY.
# FIXORA_MODEL_API_KEY can override the provider-specific key for this app.
# Ollama requires no key locally. On JacHammer localhost is the hosted server.
# FIXORA_MODEL_BASE_URL=http://localhost:11434
